{
  "name": "agendo",
  "displayName": "Agendo",
  "icon": "resources/images/agendo-icon.png",
  "description": "Agendo — view, filter, and manage markdown-file-backed todos from an Activity Bar TreeView.",
  "version": "0.3.0",
  "publisher": "jakemorgeson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JakeRoxs/agendo.git"
  },
  "bugs": {
    "url": "https://github.com/JakeRoxs/agendo/issues"
  },
  "homepage": "https://github.com/JakeRoxs/agendo#readme",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "todo",
    "markdown",
    "tasks",
    "agendo"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "agendo-container",
          "title": "Agendo",
          "icon": "resources/images/agendo-icon.svg"
        }
      ]
    },
    "views": {
      "agendo-container": [
        {
          "id": "agendo.todos",
          "name": "Todos",
          "initialSize": 8,
          "icon": "resources/images/agendo-icon.svg",
          "contextualTitle": "Agendo"
        },
        {
          "id": "agendo.codeScanning",
          "name": "Code Scanning",
          "initialSize": 5,
          "icon": "$(shield)",
          "contextualTitle": "Agendo Code Scanning"
        },
        {
          "id": "agendo.skillStatus",
          "name": "Skill",
          "initialSize": 1,
          "icon": "$(cloud-download)"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "agendo.codeScanning",
        "contents": "Loading code-scanning todos…",
        "when": "agendo.codeScanning.loading"
      },
      {
        "view": "agendo.codeScanning",
        "contents": "No code-scanning todos match the current search.\n[Clear Search](command:agendo.codeScanning.clearSearch)",
        "when": "!agendo.codeScanning.loading && agendo.codeScanning.searchActive"
      },
      {
        "view": "agendo.codeScanning",
        "contents": "No code-scanning todos match the current filters.\n[Clear Filters](command:agendo.codeScanning.clearFilters)",
        "when": "!agendo.codeScanning.loading && agendo.codeScanning.filterActive && !agendo.codeScanning.searchActive"
      },
      {
        "view": "agendo.codeScanning",
        "contents": "No code-scanning todos yet.\n[Import Code-Scanning Todos](command:agendo.importCodeScanning)",
        "when": "!agendo.codeScanning.loading && !agendo.codeScanning.filterActive"
      },
      {
        "view": "agendo.todos",
        "contents": "Loading todos…",
        "when": "agendo.loading"
      },
      {
        "view": "agendo.todos",
        "contents": "No todos match the current search.\n[Clear Search](command:agendo.clearSearch)",
        "when": "!agendo.loading && agendo.searchActive"
      },
      {
        "view": "agendo.todos",
        "contents": "No todos match the current filters.\n[Clear Filters](command:agendo.clearFilters)",
        "when": "!agendo.loading && agendo.filterActive && !agendo.searchActive"
      },
      {
        "view": "agendo.todos",
        "contents": "No todos found in the configured root folder.\n[Create a Todo](command:agendo.createTodo)\n[Choose Root Folder](command:agendo.chooseRoot)",
        "when": "!agendo.loading && !agendo.filterActive"
      }
    ],
    "commands": [
      {
        "command": "agendo.refreshComponents",
        "title": "Check Skill and Canvas Updates",
        "category": "Agendo",
        "icon": "$(refresh)"
      },
      {
        "command": "agendo.refreshComponents.loading",
        "title": "Checking Skill and Canvas Updates...",
        "category": "Agendo",
        "icon": "$(sync~spin)",
        "enablement": "false"
      },
      {
        "command": "agendo.manageSkill",
        "title": "Skill Versions and Update Actions...",
        "category": "Agendo"
      },
      {
        "command": "agendo.manageCanvas",
        "title": "Canvas Versions and Update Actions...",
        "category": "Agendo"
      },
      {
        "command": "agendo.focusCollision",
        "title": "Show Conflicting Files",
        "category": "Agendo",
        "icon": "$(warning)"
      },
      {
        "command": "agendo.copyCollisionContext",
        "title": "Copy ID Collision Reconciliation Context",
        "category": "Agendo",
        "icon": "$(copy)"
      },
      {
        "command": "agendo.copyAccomplishmentsContext",
        "title": "Copy Accomplishments Context",
        "category": "Agendo",
        "icon": "$(checklist)"
      },
      {
        "command": "agendo.codeScanning.refresh",
        "title": "Refresh Code-Scanning Todos",
        "category": "Agendo",
        "icon": "$(refresh)"
      },
      {
        "command": "agendo.codeScanning.refresh.loading",
        "title": "Refreshing Code-Scanning Todos...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.codeScanning.search",
        "title": "Search Code-Scanning Todos...",
        "category": "Agendo",
        "icon": "$(search)"
      },
      {
        "command": "agendo.codeScanning.clearSearch",
        "title": "Clear Code-Scanning Search",
        "category": "Agendo",
        "icon": "$(close)"
      },
      {
        "command": "agendo.codeScanning.filter",
        "title": "Filter Code-Scanning Todos...",
        "category": "Agendo",
        "icon": "$(filter)"
      },
      {
        "command": "agendo.codeScanning.clearFilters",
        "title": "Clear Code-Scanning Filters",
        "category": "Agendo",
        "icon": "$(clear-all)"
      },
      {
        "command": "agendo.codeScanning.openBoard",
        "title": "Open Code-Scanning Board",
        "category": "Agendo",
        "icon": "$(open-preview)"
      },
      {
        "command": "agendo.codeScanning.openBoard.loading",
        "title": "Opening Code-Scanning Board...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.codeScanning.showDigest",
        "title": "Show Code-Scanning Task Digest",
        "category": "Agendo",
        "icon": "$(list-selection)"
      },
      {
        "command": "agendo.codeScanning.showDigest.loading",
        "title": "Code-Scanning Task Digest Is Loading...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.codeScanning.toggleSortDate",
        "title": "Toggle Code-Scanning Sort by Date Modified",
        "category": "Agendo",
        "icon": "$(calendar)"
      },
      {
        "command": "agendo.importCodeScanning",
        "title": "Import Code-Scanning Todos...",
        "category": "Agendo",
        "icon": "$(shield)",
        "enablement": "isWorkspaceTrusted"
      },
      {
        "command": "agendo.refresh",
        "title": "Refresh",
        "category": "Agendo",
        "icon": "$(refresh)"
      },
      {
        "command": "agendo.refresh.loading",
        "title": "Refreshing...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.showDigest",
        "title": "Show Task Digest",
        "category": "Agendo",
        "icon": "$(list-selection)"
      },
      {
        "command": "agendo.showDigest.loading",
        "title": "Task digest is loading...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.openBoard",
        "title": "Open Board",
        "category": "Agendo",
        "icon": "$(open-preview)"
      },
      {
        "command": "agendo.openBoard.loading",
        "title": "Opening board...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.filter",
        "title": "Filter Todos...",
        "category": "Agendo",
        "icon": "$(filter)"
      },
      {
        "command": "agendo.search",
        "title": "Search Todos...",
        "category": "Agendo",
        "icon": "$(search)"
      },
      {
        "command": "agendo.clearSearch",
        "title": "Clear Search",
        "category": "Agendo",
        "icon": "$(close)"
      },
      {
        "command": "agendo.clearFilters",
        "title": "Clear Filters",
        "category": "Agendo",
        "icon": "$(clear-all)"
      },
      {
        "command": "agendo.createTodo",
        "title": "Create Todo...",
        "category": "Agendo",
        "icon": "$(add)"
      },
      {
        "command": "agendo.createTodo.loading",
        "title": "Creating todo...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.openPreview",
        "title": "Open Todo",
        "category": "Agendo"
      },
      {
        "command": "agendo.openCanvas",
        "title": "Open in Work Session Canvas",
        "category": "Agendo"
      },
      {
        "command": "agendo.installCanvas",
        "title": "Install Bundled Work Session Canvas",
        "category": "Agendo",
        "icon": "$(dashboard)"
      },
      {
        "command": "agendo.installCanvas.loading",
        "title": "Installing work-session canvas...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.setViewMode",
        "title": "Set View Mode...",
        "category": "Agendo",
        "icon": "$(open-preview)"
      },
      {
        "command": "agendo.setStatus.pending",
        "title": "Set Status: Pending",
        "category": "Agendo"
      },
      {
        "command": "agendo.setStatus.in-progress",
        "title": "Set Status: In Progress",
        "category": "Agendo"
      },
      {
        "command": "agendo.setStatus.ready",
        "title": "Set Status: Ready",
        "category": "Agendo"
      },
      {
        "command": "agendo.setStatus.backlogged",
        "title": "Set Status: Backlogged",
        "category": "Agendo"
      },
      {
        "command": "agendo.setStatus.complete",
        "title": "Set Status: Complete",
        "category": "Agendo"
      },
      {
        "command": "agendo.setStatus.cancelled",
        "title": "Set Status: Cancelled",
        "category": "Agendo"
      },
      {
        "command": "agendo.setPriority",
        "title": "Set Priority...",
        "category": "Agendo"
      },
      {
        "command": "agendo.setDependency",
        "title": "Set Dependencies...",
        "category": "Agendo"
      },
      {
        "command": "agendo.setGroup",
        "title": "Set Group...",
        "category": "Agendo"
      },
      {
        "command": "agendo.deleteTodo",
        "title": "Delete Todo",
        "category": "Agendo",
        "icon": "$(trash)"
      },
      {
        "command": "agendo.chooseRoot",
        "title": "Choose Root Folder...",
        "category": "Agendo"
      },
      {
        "command": "agendo.toggleGitignore",
        "title": "Toggle Gitignore Todos Folder",
        "category": "Agendo"
      },
      {
        "command": "agendo.setDefault.root",
        "title": "Set Default Root Folder...",
        "category": "Agendo"
      },
      {
        "command": "agendo.setDefault.priority",
        "title": "Set Default Priority...",
        "category": "Agendo"
      },
      {
        "command": "agendo.setDefault.preview",
        "title": "Set Default View Mode...",
        "category": "Agendo"
      },
      {
        "command": "agendo.enableSkill",
        "title": "Install Bundled Agendo Skill",
        "category": "Agendo",
        "icon": "$(cloud-download)"
      },
      {
        "command": "agendo.updateSkill",
        "title": "Install Agendo Skill from Configured Source",
        "category": "Agendo"
      },
      {
        "command": "agendo.updateCanvas",
        "title": "Install Work Session Canvas from Configured Source",
        "category": "Agendo"
      },
      {
        "command": "agendo.enableSkill.loading",
        "title": "Installing Agendo skill...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.updateSkill.loading",
        "title": "Updating Agendo skill...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.updateCanvas.loading",
        "title": "Updating work-session canvas...",
        "category": "Agendo",
        "icon": "$(sync~spin)"
      },
      {
        "command": "agendo.toggleSkillUpdateCheck",
        "title": "Toggle Skill and Canvas Update Notifications",
        "category": "Agendo",
        "icon": "$(bell)"
      },
      {
        "command": "agendo.toggleSortDate",
        "title": "Toggle Sort by Date Modified",
        "category": "Agendo",
        "icon": "$(calendar)"
      },
      {
        "command": "agendo.collapseNode",
        "title": "Collapse",
        "category": "Agendo"
      },
      {
        "command": "agendo.expandNode",
        "title": "Expand",
        "category": "Agendo"
      },
      {
        "command": "agendo.refreshScanningTodo",
        "title": "Refresh Imported Todo",
        "category": "Agendo",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agendo.importCodeScanning",
          "when": "view == agendo.codeScanning",
          "group": "navigation@1"
        },
        {
          "command": "agendo.codeScanning.showDigest",
          "when": "view == agendo.codeScanning && !agendo.codeScanning.digestLoading",
          "group": "navigation@2"
        },
        {
          "command": "agendo.codeScanning.showDigest.loading",
          "when": "view == agendo.codeScanning && agendo.codeScanning.digestLoading",
          "group": "navigation@2"
        },
        {
          "command": "agendo.codeScanning.openBoard",
          "when": "view == agendo.codeScanning && !agendo.codeScanning.openingBoard",
          "group": "navigation@2.5"
        },
        {
          "command": "agendo.codeScanning.openBoard.loading",
          "when": "view == agendo.codeScanning && agendo.codeScanning.openingBoard",
          "group": "navigation@2.5"
        },
        {
          "command": "agendo.codeScanning.search",
          "when": "view == agendo.codeScanning && !agendo.codeScanning.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "agendo.codeScanning.clearSearch",
          "when": "view == agendo.codeScanning && agendo.codeScanning.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "agendo.codeScanning.filter",
          "when": "view == agendo.codeScanning",
          "group": "navigation@4"
        },
        {
          "command": "agendo.codeScanning.refresh",
          "when": "view == agendo.codeScanning && !agendo.codeScanning.refreshing",
          "group": "navigation@5"
        },
        {
          "command": "agendo.codeScanning.refresh.loading",
          "when": "view == agendo.codeScanning && agendo.codeScanning.refreshing",
          "group": "navigation@5"
        },
        {
          "command": "agendo.codeScanning.clearFilters",
          "when": "view == agendo.codeScanning",
          "group": "1_filters@1"
        },
        {
          "command": "agendo.codeScanning.toggleSortDate",
          "when": "view == agendo.codeScanning",
          "group": "2_config@1"
        },
        {
          "command": "agendo.createTodo",
          "when": "view == agendo.todos && !agendo.creatingTodo",
          "group": "navigation@1"
        },
        {
          "command": "agendo.createTodo.loading",
          "when": "view == agendo.todos && agendo.creatingTodo",
          "group": "navigation@1"
        },
        {
          "command": "agendo.search",
          "when": "view == agendo.todos && !agendo.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "agendo.clearSearch",
          "when": "view == agendo.todos && agendo.searchActive",
          "group": "navigation@3"
        },
        {
          "command": "agendo.showDigest",
          "when": "view == agendo.todos && !agendo.digestLoading",
          "group": "navigation@2"
        },
        {
          "command": "agendo.showDigest.loading",
          "when": "view == agendo.todos && agendo.digestLoading",
          "group": "navigation@2"
        },
        {
          "command": "agendo.openBoard",
          "when": "view == agendo.todos && !agendo.openingBoard",
          "group": "navigation@2.5"
        },
        {
          "command": "agendo.openBoard.loading",
          "when": "view == agendo.todos && agendo.openingBoard",
          "group": "navigation@2.5"
        },
        {
          "command": "agendo.filter",
          "when": "view == agendo.todos",
          "group": "navigation@4"
        },
        {
          "command": "agendo.refresh",
          "when": "view == agendo.todos && !agendo.refreshing",
          "group": "navigation@5"
        },
        {
          "command": "agendo.refresh.loading",
          "when": "view == agendo.todos && agendo.refreshing",
          "group": "navigation@5"
        },
        {
          "command": "agendo.clearFilters",
          "when": "view == agendo.todos",
          "group": "1_filters@1"
        },
        {
          "command": "agendo.chooseRoot",
          "when": "view == agendo.todos",
          "group": "2_config@1"
        },
        {
          "command": "agendo.setDefault.root",
          "when": "view == agendo.todos",
          "group": "2_config@2"
        },
        {
          "command": "agendo.setDefault.priority",
          "when": "view == agendo.todos",
          "group": "2_config@3"
        },
        {
          "command": "agendo.setDefault.preview",
          "when": "view == agendo.todos",
          "group": "2_config@4"
        },
        {
          "command": "agendo.toggleGitignore",
          "when": "view == agendo.todos",
          "group": "2_config@5"
        },
        {
          "command": "agendo.setViewMode",
          "when": "view == agendo.todos",
          "group": "2_config@6"
        },
        {
          "command": "agendo.toggleSortDate",
          "when": "view == agendo.todos",
          "group": "2_config@7"
        },
        {
          "command": "agendo.refreshComponents",
          "when": "view == agendo.skillStatus && !agendo.componentsChecking",
          "group": "navigation@1"
        },
        {
          "command": "agendo.refreshComponents.loading",
          "when": "view == agendo.skillStatus && agendo.componentsChecking",
          "group": "navigation@1"
        },
        {
          "command": "agendo.enableSkill",
          "when": "view == agendo.skillStatus && !agendo.skillInstalling",
          "group": "skill@1"
        },
        {
          "command": "agendo.installCanvas",
          "when": "view == agendo.skillStatus && !agendo.canvasInstalling",
          "group": "skill@3"
        },
        {
          "command": "agendo.installCanvas.loading",
          "when": "view == agendo.skillStatus && agendo.canvasInstalling",
          "group": "skill@3"
        },
        {
          "command": "agendo.updateSkill",
          "when": "view == agendo.skillStatus && !agendo.skillUpdating",
          "group": "skill@2"
        },
        {
          "command": "agendo.updateCanvas",
          "when": "view == agendo.skillStatus && !agendo.canvasUpdating",
          "group": "skill@4"
        },
        {
          "command": "agendo.enableSkill.loading",
          "when": "view == agendo.skillStatus && agendo.skillInstalling",
          "group": "skill@1"
        },
        {
          "command": "agendo.updateSkill.loading",
          "when": "view == agendo.skillStatus && agendo.skillUpdating",
          "group": "skill@2"
        },
        {
          "command": "agendo.updateCanvas.loading",
          "when": "view == agendo.skillStatus && agendo.canvasUpdating",
          "group": "skill@4"
        },
        {
          "command": "agendo.toggleSkillUpdateCheck",
          "when": "view == agendo.skillStatus",
          "group": "skill@3"
        }
      ],
      "commandPalette": [
        {
          "command": "agendo.refreshComponents.loading",
          "when": "false"
        },
        {
          "command": "agendo.openCanvas",
          "when": "false"
        }
      ],
      "webview/context": [
        {
          "command": "agendo.copyCollisionContext",
          "when": "(webviewId == 'agendo.board' || webviewId == 'agendo.codeScanning.board') && webviewSection == 'todoCard' && todoIdCollision",
          "group": "agendo@2"
        },
        {
          "command": "agendo.openCanvas",
          "when": "(webviewId == 'agendo.board' || webviewId == 'agendo.codeScanning.board') && webviewSection == 'todoCard'",
          "group": "1_open@1"
        },
        {
          "command": "agendo.refreshScanningTodo",
          "when": "webviewId == 'agendo.codeScanning.board' && webviewSection == 'todoCard'",
          "group": "5_scanning@1"
        }
      ],
      "view/item/context": [
        {
          "command": "agendo.focusCollision",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /Collision/",
          "group": "inline@0"
        },
        {
          "command": "agendo.copyCollisionContext",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /Collision/",
          "group": "1_reconcile@1"
        },
        {
          "command": "agendo.collapseNode",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /sourceGroup|statusGroup|priorityGroup|groupGroup/",
          "group": "1_collapse@1"
        },
        {
          "command": "agendo.expandNode",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /sourceGroup|statusGroup|priorityGroup|groupGroup/",
          "group": "1_collapse@2"
        },
        {
          "command": "agendo.openPreview",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "1_open@1"
        },
        {
          "command": "agendo.openCanvas",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "1_open@2"
        },
        {
          "command": "agendo.setStatus.pending",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "2_status@1"
        },
        {
          "command": "agendo.setStatus.in-progress",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "2_status@2"
        },
        {
          "command": "agendo.setStatus.ready",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "2_status@3"
        },
        {
          "command": "agendo.setStatus.backlogged",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "2_status@4"
        },
        {
          "command": "agendo.setStatus.complete",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "2_status@5"
        },
        {
          "command": "agendo.setStatus.cancelled",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "2_status@6"
        },
        {
          "command": "agendo.setPriority",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "3_priority@1"
        },
        {
          "command": "agendo.setDependency",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "3_priority@2"
        },
        {
          "command": "agendo.setGroup",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "3_priority@3"
        },
        {
          "command": "agendo.deleteTodo",
          "when": "(view == agendo.todos || view == agendo.codeScanning) && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "4_delete@1"
        },
        {
          "command": "agendo.refreshScanningTodo",
          "when": "view == agendo.codeScanning && viewItem =~ /todoItem|todoItemBlocked/",
          "group": "5_scanning@1"
        }
      ]
    },
    "configuration": {
      "title": "Agendo",
      "properties": {
        "agendo.codeScanning.sortByDate": {
          "type": "boolean",
          "default": false,
          "description": "Sort code-scanning todos by last modified date independently of the regular Todos view."
        },
        "agendo.codeScanning.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable optional, manually triggered CodeQL and SonarQube imports. Existing scanning todos remain visible when disabled."
        },
        "agendo.codeScanning.sonarqube.url": {
          "type": "string",
          "default": "",
          "description": "SonarQube server URL. Tokens are stored separately in VS Code SecretStorage, never in settings."
        },
        "agendo.codeScanning.sonarqube.projectKey": {
          "type": "string",
          "default": "",
          "description": "SonarQube project key used for importing unresolved issues."
        },
        "agendo.root": {
          "type": "string",
          "default": "docs/todos",
          "description": "Workspace-relative path to the root todos folder."
        },
        "agendo.defaultPriority": {
          "type": "string",
          "enum": [
            "p1",
            "p2",
            "p3"
          ],
          "default": "p3",
          "description": "Default priority applied to newly created todos."
        },
        "agendo.completeFolder": {
          "type": "string",
          "default": "complete",
          "description": "Subfolder name (under the root) for completed todos."
        },
        "agendo.cancelledFolder": {
          "type": "string",
          "default": "cancelled",
          "description": "Subfolder name (under the root) for cancelled todos."
        },
        "agendo.backlogFolder": {
          "type": "string",
          "default": "backlog",
          "description": "Subfolder name (under the root) for backlogged todos."
        },
        "agendo.openInPreview": {
          "type": "boolean",
          "default": true,
          "deprecationMessage": "Use 'agendo.viewMode' instead. This setting is kept as a fallback when viewMode is not explicitly set.",
          "description": "Deprecated. Use 'agendo.viewMode' instead. Open todos in preview mode using your default markdown editor. Requires 'Files: Enable Preview' enabled in VS Code settings."
        },
        "agendo.viewMode": {
          "type": "string",
          "enum": [
            "default",
            "editor",
            "preview",
            "previewEditor",
            "canvas"
          ],
          "default": "default",
          "enumDescriptions": [
            "Open todos using VS Code's own default behavior (respects your editor associations).",
            "Open todos in the source text editor, forcing the plain text editor even when markdown uses a custom editor.",
            "Open todos as a rendered markdown preview.",
            "Open todos with VS Code's newer (beta) markdown editor preview when available.",
            "Open todos in the Agendo work-session canvas: an interactive dashboard with clickable acceptance criteria, dependencies, and history."
          ],
          "description": "How todos open when clicked: VS Code's default, the forced source editor, the markdown preview, VS Code's beta preview editor, or the work-session canvas."
        },
        "agendo.gitignoreTodos": {
          "type": "boolean",
          "default": true,
          "description": "When enabled, write a .gitignore into the todos root folder that ignores everything except the .gitignore itself and .agendo-config.json, so the config stays discoverable by search tools and the Agendo skill."
        },
        "agendo.skillUpdateSource": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/JakeRoxs/agendo/main/resources/skill",
          "description": "HTTPS base URL for checking and installing the skill from source. Defaults to GitHub/main, which can differ from the version bundled in this extension."
        },
        "agendo.canvasUpdateSource": {
          "type": "string",
          "default": "https://raw.githubusercontent.com/JakeRoxs/agendo/main/resources/canvas/agendo-work-session",
          "description": "HTTPS base URL for checking and installing the canvas from source. Defaults to GitHub/main, which can differ from the version bundled in this extension."
        },
        "agendo.showDependencyNodes": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, blocked todos appear as collapsible dependency nodes under their blockers in the tree view instead of in their priority group."
        },
        "agendo.skillUpdateCheck": {
          "type": "boolean",
          "default": true,
          "description": "Notify on activation when the skill or canvas bundled with this extension is newer than the installed copy. Does not install automatically or contact GitHub; source checks are explicit in Versions and Update Actions."
        },
        "agendo.sortByDate": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, sort todos within each priority group by last modified date (most recent first) instead of by issue ID."
        }
      }
    }
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.1.0"
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "node ./out/test/runTest.js",
    "test:coverage": "npm run compile && npm run lint && c8 --reporter=lcov --report-dir=coverage node ./out/test/runTest.js",
    "package:vsix": "npm run compile && node -e \"const fs=require('fs'); fs.mkdirSync('.artifacts', { recursive: true });\" && npx @vscode/vsce package --out .artifacts/agendo-${npm_package_version}.vsix"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "26.x",
    "@types/turndown": "^5.0.6",
    "@types/vscode": "^1.103.0",
    "@vscode/test-electron": "^3.1.0",
    "c8": "^12.0.0",
    "glob": "^13.0.6",
    "mocha": "^12.0.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "turndown": "^7.2.4"
  }
}
