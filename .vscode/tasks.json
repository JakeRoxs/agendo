{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "bumpLevel",
      "type": "pickString",
      "description": "Version bump level",
      "options": ["patch", "minor", "major"],
      "default": "patch"
    }
  ],
  "tasks": [
    {
      "label": "Lint",
      "type": "npm",
      "script": "lint",
      "problemMatcher": [],
      "group": "lint",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": ["watch"]
    },
    {
      "label": "Fix Lint",
      "type": "npm",
      "script": "lint:fix",
      "problemMatcher": [],
      "group": "lint",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": ["watch"]
    },
    {
      "label": "Format",
      "type": "npm",
      "script": "format",
      "problemMatcher": [],
      "group": "format",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      },
      "dependsOn": ["watch"]
    },
    {
      "label": "Package VSIX",
      "type": "npm",
      "script": "package:vsix",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Bump Version",
      "type": "shell",
      "command": "npm version ${input:bumpLevel} --no-git-tag-version",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
