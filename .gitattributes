# Force LF line endings in the repository
# This prevents CRLF/LF mismatches when moving between Linux and Windows

# All text files get LF line endings in the repo
* text=auto eol=lf

# Explicitly mark source files
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf

# Binary files should not be touched
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.vsix binary
